# ==============================================================================
# Database (PostgreSQL) Configuration
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prm_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ==============================================================================
# JWT Security Configuration
# ==============================================================================
JWT_SECRET=PRM_PLATFORM_SUPER_SECRET_KEY_FOR_JWT_SIGNING_2026_VERY_SECURE
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================================
# Email Service Configuration (Brevo REST API - HTTPS 443)
# ==============================================================================
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@historypodcast.com
BREVO_SENDER_NAME=History Podcast Platform

# ==============================================================================
# Media Storage Configuration (Cloudinary SDK)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=history-podcast

# ==============================================================================
# Firebase Phone Authentication (Google Identity Toolkit)
# ==============================================================================
FIREBASE_API_KEY=your_firebase_web_api_key_here

# ==============================================================================
# VNPay Sandbox Configuration
# ==============================================================================
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
