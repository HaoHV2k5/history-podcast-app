# ==============================================================================
# Whiteboard Studio & RAG History Pipeline Configuration (System Level)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI SYSTEM API KEY (BẮT BUỘC CHO HỆ THỐNG / ADMIN)
# ------------------------------------------------------------------------------
# Key này dùng để:
#   - Quét và nhúng (embedding) toàn bộ tài liệu lịch sử từ thư mục `doc/` vào Vector DB
#   - Làm fallback khi cần kiểm thử hệ thống
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
SYSTEM_GEMINI_API_KEY=AIzaSy_YOUR_SYSTEM_GEMINI_API_KEY_HERE

# ------------------------------------------------------------------------------
# 2. RAG & VECTOR DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Model embedding chuẩn của Google (tối ưu tiếng Việt, đa ngữ)
EMBEDDING_MODEL=gemini-embedding-001

# Thư mục chứa sách lịch sử (tính từ thư mục tool_video_v5)
DOC_DIR=../doc

# Thư mục lưu trữ cơ sở dữ liệu Vector (ChromaDB cục bộ)
CHROMA_DB_DIR=./data/chroma_db

# Số lượng đoạn trích xuất sử liệu liên quan nhất được lấy cho mỗi câu hỏi/kịch bản
RAG_TOP_K=5

# Ngưỡng tương đồng cosine tối thiểu để coi là tài liệu khớp (0.0 đến 1.0)
RAG_SIMILARITY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 3. GEMINI GENERATION CONFIGURATION (FALLBACK / ADMIN)
# ------------------------------------------------------------------------------
# Model sinh kịch bản & thẩm định lịch sử
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
